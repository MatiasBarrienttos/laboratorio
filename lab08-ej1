#include <iostream>
using namespace std;

int leerCantidadNotas();
double leerSumaNotas(int cantidaNotas);

double calcularNotas (double sumaNotas, int cantidadNotas);
bool determinarAprobacion(double promedio);
void mostrarResultados (double promedio, bool aprobado);

int main () {

    int cantidadNotas;
    double sumaNotas, promedio;
    bool aprobado;

    cantidadNotas= leerCantidadNotas();
    sumaNotas= leerSumaNotas(cantidadNotas);
    promedio= calcularNotas(sumaNotas, cantidadNotas);
    aprobado=determinarAprobacion(promedio);
    mostrarResultados(promedio, aprobado);

    return 0;
}

int leerCantidadNotas() {
    int cantidad;
    do {
        cout << "Ingrese la cantidad de evaluaciones: ";
        cin >> cantidad;
        if (cantidad <= 0) {
            cout << "La cantidad debe ser mayor a 0. Intente de nuevo.\n";
        }
    } while (cantidad <= 0);
    return cantidad;
}

double leerSumaNotas(int cantidadNotas) {
    double suma = 0.0, nota;
    for (int i = 1; i <= cantidadNotas; i++) {
        do {
            cout << "Ingrese la nota " << i << " (0-100): ";
            cin >> nota;
            if (nota < 0 || nota > 100) {
                cout << "Nota invalida, debe ser un valor entre 0 y 100.\n";
            }
        } while (nota < 0 || nota > 100);
        suma += nota;
    }
    return suma;
}


double calcularNotas(double sumaNotas, int cantidadNotas) {
    return sumaNotas / cantidadNotas;
}

bool determinarAprobacion(double promedio) {
    return promedio >= 51.0;
}

void mostrarResultados(double promedio, bool aprobado) {
    cout << "\n-----------------------------" << endl;
    cout << "Promedio obtenido: " << promedio << " pts" << endl;
    if (aprobado) {
        cout << "Estado final     : APROBADO" << endl;
    } else {
        cout << "Estado final     : REPROBADO" << endl;
    }
    cout << "-----------------------------" << endl;
}
